{
  "name": "equisproject-online",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter web dev",
    "dev:api": "bun run --filter api dev",
    "build": "bun run --filter web build",
    "start": "bun run --filter api start",
    "preview": "bun run --filter web preview",
    "test": "bun run --filter shared test",
    "typecheck": "bun run --filter shared typecheck && bun run --filter web typecheck",
    "production": "bun run build && bun run start"
  }
}
